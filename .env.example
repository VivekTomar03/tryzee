# Server — Render sets PORT itself; leave it unset there.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tryItExtension?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Cloudinary — profile photo uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gemini image generation
GEMINI_API_KEY=your_gemini_api_key
# Ids must contain "image" — a text model accepts image input but can never
# return an image. Tried in order, falling back on 503/429.
GEMINI_IMAGE_MODELS=gemini-3-pro-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-2.5-flash-image
GEMINI_RETRIES_PER_MODEL=2
GEMINI_ATTEMPT_TIMEOUT_MS=60000
GEMINI_TOTAL_BUDGET_MS=150000

# Image handling (defaults live in code; override only if needed)
MAX_IMAGE_DIMENSION=1024
JPEG_QUALITY=85
IMAGE_FETCH_TIMEOUT_MS=15000

# Scraping (defaults live in code)
SCRAPE_AXIOS_TIMEOUT_MS=15000
SCRAPE_PUPPETEER_TIMEOUT_MS=45000
